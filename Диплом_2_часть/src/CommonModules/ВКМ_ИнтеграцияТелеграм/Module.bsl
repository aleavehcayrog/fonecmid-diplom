
#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьСообщение(Знач ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_TelegramBotToken.Получить();
	ЧатID = Константы.ВКМ_TelegramChatID.Получить();
	
	Если Не ЗначениеЗаполнено(Токен) Тогда
		Сообщить("Не заполнена константа TelegramBotToken");
		Возврат;
	КонецЕсли;
	 
	Если Не ЗначениеЗаполнено(ЧатID) Тогда
		Сообщить("Не заполнена константа TelegramChatID");
		Возврат;
	КонецЕсли;
	 
	ТелоЗапроса = СформироватьJSON(ЧатID, ТекстСообщения);

	ОтправитьЗапрос(Токен, ТелоЗапроса);
	
КонецПроцедуры

// Сформировать JSON для отправки
Функция СформироватьJSON(Знач ЧатID, Знач ТекстСообщения)
	
	ЗапросСтруктура = Новый Структура;
	ЗапросСтруктура.Вставить("chat_id", ЧатID);
	ЗапросСтруктура.Вставить("text", ТекстСообщения);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ЗапросСтруктура);
	
	Возврат ЗаписьJSON.ЗакрытьИПолучитьСтроку();
	
КонецФункции

// Отправить HTTP запрос к API Telegram
Процедура ОтправитьЗапрос(Знач Токен, Знач ТелоЗапроса)
	
	HTTPS = Новый HTTPСоединение("api.telegram.org", 443);
	Ресурс = "/bot" + Токен + "/sendMessage";
	Заголовки = Новый Структура("Content-Type", "application/json");
	
	Попытка
		Ответ = HTTPS.ОтправитьДляОбработки("POST", Ресурс, , ТелоЗапроса, , , Заголовки);
		
		Если Ответ.КодСостояния = 200 Тогда
			// Успешно отправлено
			ЗаписьЖурналаРегистрации("Телеграм", УровеньЖурналаРегистрации.Информация, , , 
				"Сообщение успешно отправлено в Telegram");
		Иначе
			// Ошибка на стороне сервера
			ТекстОшибки = Ответ.ПолучитьТелоКакСтроку();
			ЗаписьЖурналаРегистрации("Телеграм", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при отправке в Telegram. Код: " + Ответ.КодСостояния + 
				". Ответ: " + ТекстОшибки);
		КонецЕсли;
		
	Исключение
		// Ошибка соединения
		ЗаписьЖурналаРегистрации("Телеграм", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка соединения с Telegram API: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьУведомленияТелеграм() Экспорт
	
	// Выбираем все уведомления из справочника
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВКМ_УведомленияТелеграмБоту.Ссылка КАК Ссылка,
		|	ВКМ_УведомленияТелеграмБоту.ВКМ_ТекстСообщения КАК ТекстСообщения
		|ИЗ
		|	Справочник.ВКМ_УведомленияТелеграмБоту КАК ВКМ_УведомленияТелеграмБоту";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВКМ_ИнтеграцияТелеграм.ОтправитьСообщение(ВыборкаДетальныеЗаписи.ТекстСообщения);//если успешно
		Если ВыборкаДетальныеЗаписи.Ссылка = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	 
КонецПроцедуры	

